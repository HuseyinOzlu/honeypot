# ==============================================================================
# ANTIGRAVITY HONEYPOT PLATFORM - PYTHON FAKE ENVIRONMENT RUNTIME
# Runs the lightweight VFS and Nano/Top simulations as a low-cost fallback
# ==============================================================================

FROM python:3.11-slim

WORKDIR /app

# Prevent Python from writing pyc files and buffering stdout
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Copy project files into container
COPY . /app/

# Install requirements if present
RUN if [ -f "requirements.txt" ]; then pip install --no-cache-dir -r requirements.txt; fi

EXPOSE 6000

# Start Fake Environment Worker
CMD ["python", "-m", "internal.environments.fake.server"]
